# SITE_ADDRESS is ":80" (plain HTTP on the server's IP) until there's a domain.
# Set it to the domain (e.g. "example.com") and Caddy gets an HTTPS certificate automatically.
{$SITE_ADDRESS}

encode zstd gzip

request_body {
	max_size 30MB
}

# Umami's tracker script and collect endpoint only. Its dashboard and login stay off the internet.
@stats path /stats/script.js /stats/api/send
handle @stats {
	uri strip_prefix /stats
	reverse_proxy umami:3000
}

handle {
	reverse_proxy app:8000
}
