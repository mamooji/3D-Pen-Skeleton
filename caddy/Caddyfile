{
	servers {
		# Cloudflare sits in front of the site. For requests from its IP ranges (https://www.cloudflare.com/ips/),
		# {client_ip} is the visitor's IP from CF-Connecting-IP. Requests from anywhere else (e.g. straight to the
		# server's IP) keep their own address, so nobody can fake their IP with a header to get around rate limits.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# SITE_ADDRESS (in /opt/skeleton3d/.env) is "trace3dpen.com www.trace3dpen.com".
{$SITE_ADDRESS} {
	# Cloudflare Origin CA certificate for trace3dpen.com and *.trace3dpen.com, valid until 2041-10-05. Only
	# Cloudflare trusts it, which is all the origin needs (SSL/TLS mode Full (strict)). It replaces Let's Encrypt,
	# whose renewals would have to reach the server through Cloudflare. The files live on the server only, in
	# /opt/skeleton3d/certs/ (see PLAN.md).
	tls /certs/origin.pem /certs/origin.key

	encode zstd gzip

	request_body {
		max_size 30MB
	}

	# Files that never change at the same URL: Vite's built assets have a content hash in their names, and the
	# background-removal model's name has a version (frontend/src/lib/cutout.ts). Browsers and Cloudflare can keep them.
	@immutable path /assets/* /models/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# www.example.com -> example.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Umami's tracker script and collect endpoint only. Its dashboard and login stay off the internet.
	@stats path /stats/script.js /stats/api/send
	handle @stats {
		uri strip_prefix /stats
		reverse_proxy umami:3000 {
			# Umami reads the visitor's IP from this header (CLIENT_IP_HEADER in docker-compose.yml).
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy app:8000 {
			# The app (uvicorn --proxy-headers) takes the first X-Forwarded-For entry, so send only the real one.
			header_up X-Forwarded-For {client_ip}
		}
	}
}
